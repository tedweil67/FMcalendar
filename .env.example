# Copy to .env for local development (or set these directly as Render env vars).

# --- Data source ---
# 'mock'  = in-memory demo data, no FileMaker connection needed (default, safe for local dev)
# 'odata' = live FileMaker Server via OData - requires FM_BASE_URL/FM_DATABASE/FM_USERNAME/FM_PASSWORD below
FM_MODE=mock

FM_BASE_URL=https://your-fmserver.example.com
FM_DATABASE=YourDatabaseName
FM_USERNAME=odata_svc
FM_PASSWORD=change-me

# --- App auth (single shared login for all staff) ---
SHARED_USERNAME=staff
SHARED_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string

# Silent sign-in for a FileMaker Web Viewer link (see README "Embedding in a
# FileMaker Web Viewer") - a separate secret from SHARED_USERNAME/PASSWORD so
# it can be rotated independently. On Render this is auto-generated.
WEBVIEWER_TOKEN=change-me-to-a-long-random-string

# --- Server ---
PORT=3000
NODE_ENV=development
